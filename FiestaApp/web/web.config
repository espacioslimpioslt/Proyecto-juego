<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuracion para IIS + iisnode (MonsterASP.NET y similares).
  - Todo pedido (paginas, /api, /socket.io) va a Node: Express sirve public/.
  - webSocket de IIS apagado: asi las conexiones en tiempo real las maneja
    Node (Socket.io). Si el hosting no deja pasar WebSockets, Socket.io usa
    "long polling" solo, sin cambiar nada.
  - Un unico proceso de Node: las salas viven en memoria, y con dos procesos
    cada uno tendria salas distintas.
  - Si el proceso de IIS se cae apenas arranca (registro de eventos: "el
    grupo de aplicaciones finalizo inesperadamente"), probar el grupo de
    aplicaciones en 64 bits (x64) en lugar de 32 bits (x86).
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />
    <handlers>
      <add name="iisnode" path="app.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="TodoANode" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="app.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode nodeProcessCountPerApplication="1" devErrorsEnabled="true" />
  </system.webServer>
</configuration>
